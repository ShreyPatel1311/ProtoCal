# ---- IRIS credentials (copy to .env and fill in; .env is gitignored) ----

# Long-lived Claude Code token for headless use.
# Create it by running:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Semantic Scholar API key (literature retrieval / ScholarQA)
SEMANTIC_SCHOLAR_API_KEY=

# ---- optional tuning ----
IRIS_CLAUDE_MODEL=sonnet
IRIS_CLAUDE_CONCURRENCY=3
IRIS_CLAUDE_TIMEOUT=600

# Explicit path to the claude executable (optional; auto-detected otherwise)
CLAUDE_CODE_BIN=/home/godseye/.npm-global/bin/claude
